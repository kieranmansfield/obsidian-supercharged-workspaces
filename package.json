{
	"name": "supercharged-workspaces",
	"version": "0.0.6",
	"description": "Save, load, and manage workspace layouts with enhanced features for power users.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"update": "ncu -i",
		"lint": "eslint --fix",
		"lint:fix": "eslint . --fix",
		"format": "prettier --config prettier.config.cjs --ignore-path .prettierignore --write .",
		"format:check": "prettier --config prettier.config.cjs --ignore-path .prettierignore --check .",
		"cleancache": "pnpm store prune",
		"clean": "rm -rf node_modules pnpm-lock.yaml main.js && pnpm store prune"
	},
	"keywords": [],
	"author": "Kieran Mansfield",
	"packageManager": "pnpm@11.4.0",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "8.60.0",
		"@typescript-eslint/parser": "8.60.0",
		"builtin-modules": "5.2.0",
		"esbuild": "0.28.0",
		"eslint": "^10.4.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "latest",
		"prettier": "^3.8.3",
		"tslib": "2.8.1",
		"typescript": "6.0.3"
	}
}
